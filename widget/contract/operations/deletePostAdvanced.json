{
  "name": "deletePostAdvanced",
  "displayName": "Delete post",
  "type": "function",
  "crudMode": "delete",
  "flags": [
    "mutable",
    "dangerous",
    "unthrottable"
  ],
  "usage": "advanced",
  "alternatives": [
    {
      "operationName": "deletePost",
      "label": "Basic"
    }
  ],
  "availableFor": [
    "API",
    "form"
  ],
