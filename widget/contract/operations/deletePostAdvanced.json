        "error": {
          "type": "object|string",
          "description": "Why it wasn't removed, such as no post having that id."
        },
        "result": {
          "type": "object",
          "description": "The post that was removed.",
          "properties": {
            "id": {
              "type": "string",
              "description": "The removed post's id."
            },
            "status": {
              "type": "string",
              "description": "Says the post was removed."
            }
          }
        }
      }
    }
  }
